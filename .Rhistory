plot_grid(p1, p2,
labels = c('A) Graduation Rate', 'B) Percent Married'),
hjust = -0.3, vjust = 4, label_size = 10, title='h')
library(cowplot)
plot_grid(p1, p2,
labels = c('A) Graduation Rate', 'B) Percent Married'),
hjust = -0.3, vjust = 4, label_size = 10)
