library(sf)
library(dplyr)
library(spData)
library(ggplot2)
library(ggthemes)
library(spdep)
library(spatialreg)
library(GWmodel)
library(tidyr)
setwd("data/")
#U.S. Census Bureau. "Selected Characteristics of the Total and Native Populations in the United States." American Community Survey, ACS 5-Year Estimates Subject Tables, Table S0601, https://data.census.gov/table/ACSST5Y2024.S0601?g=050XX00US12095$1400000. Accessed on 12 Apr 2026.
tracts = st_read('tl_2025_12_tract/tl_2025_12_tract.shp')
florida = read.csv('florida_char.csv')
# Renaming the columns to the ACS descriptors
colnames(florida) = florida[1,]
# Storing the geoid for a geometry column join
geoid = florida$Geography
geoid = geoid[-1]
# We do not need margin of error for the purpose of this analysis
florida = florida %>% select(contains("Estimate!!Total!!"))
# Renaming the columns to remove unnecessary words
colnames(florida) = florida[1,] %>% mutate(across(everything(), gsub, pattern = "Estimate!!Total!!", replacement = ""))
florida = florida[-1,]
new_colnames <- c(
"total_pop",
"pop_under_5",
"pop_5_to_17",
"pop_18_to_24",
"pop_25_to_44",
"pop_45_to_54",
"pop_55_to_64",
"pop_65_to_74",
"pop_75_plus",
"median_age",
"pop_male",
"pop_female",
"race_one_race",
"race_white",
"race_black",
"race_aian",
"race_asian",
"race_nhpi",
"race_other",
"race_two_or_more",
"hispanic_latino",
"white_non_hispanic",
"lang_pop_5_plus",
"lang_non_english",
"lang_non_english_speak_english_very_well",
"lang_non_english_speak_english_less_than_very_well",
"marital_pop_15_plus",
"marital_never_married",
"marital_married",
"marital_divorced_separated",
"marital_widowed",
"educ_pop_25_plus",
"educ_less_than_hs",
"educ_hs_grad",
"educ_some_college_or_associates",
"educ_bachelors",
"educ_graduate_professional",
"income_pop_15_plus",
"income_1_to_9999",
"income_10000_to_14999",
"income_15000_to_24999",
"income_25000_to_34999",
"income_35000_to_49999",
"income_50000_to_64999",
"income_65000_to_74999",
"income_75000_plus",
"median_income",
"poverty_pop",
"poverty_below_100pct",
"poverty_100_to_149pct",
"poverty_at_or_above_150pct",
"pct_allocated_citizenship",
"pct_allocated_place_of_birth"
)
colnames(florida) = new_colnames
florida = lapply(florida, as.numeric) %>% data.frame()
florida = florida %>% mutate(poverty_below_150 = poverty_below_100pct + poverty_100_to_149pct)
# Adding the geoid back
florida = florida %>% cbind(geoid)
# Adding the geometry column for spatial analysis
florida = tracts %>% select(GEOIDFQ) %>% right_join(florida, by = c("GEOIDFQ"="geoid"))
# Removing NA rows
model_df = florida %>% na.omit()
fl_list <- model_df %>%
poly2nb(st_geometry(model_df)) %>%
nb2listw(zero.policy = TRUE)
summary(florida %>% select(contains('poverty')))
ggplot(florida) +
geom_point(aes(lang_non_english_speak_english_less_than_very_well, poverty_below_150)) +
geom_smooth(aes(lang_non_english_speak_english_less_than_very_well, poverty_below_150), method = "lm")
ggplot(florida) + geom_point(aes(marital_married, poverty_below_150)) + geom_smooth(aes(marital_married, poverty_below_150), method = "lm")
moran.plot(model_df$poverty_below_150,
fl_list,
zero.policy = TRUE,
xlab = 'Percent Poverty below 150%',
ylab = 'Lagged Percent Poverty below 150% (of Neighbors)',
pch=20, labels = F)
# Now we can derive the cluster/outlier types (COType in ArcGIS term) for each spatial feature in the data
library(magrittr)
library(tidyr)
lisaRslt <- localmoran(model_df$poverty_below_150, fl_list,
zero.policy = TRUE, na.action = na.omit)
significanceLevel <- 0.05; # 95% confidence
meanVal <- mean(model_df$poverty_below_150);
lisaRslt %<>% as_tibble() %>%
set_colnames(c("Ii","E.Ii","Var.Ii","Z.Ii","Pr(z > 0)")) %>%
#Create a new categorical value
#This variable will call insignificant units "insignificant"
#Outliers are determined by LI <0 - units higher than the mean are HL and units lower than the mean are LH
#Clusters are units with LI >= 0, and classified as HH or LL based on whether they are above or below the mean
mutate(coType = case_when(
`Pr(z > 0)` > 0.05 ~ "Insignificant",
`Pr(z > 0)` <= 0.05 & Ii >= 0 & model_df$poverty_below_150 >= meanVal ~ "HH",
`Pr(z > 0)` <= 0.05 & Ii >= 0 & model_df$poverty_below_150 < meanVal ~ "LL",
`Pr(z > 0)` <= 0.05 & Ii < 0 & model_df$poverty_below_150 >= meanVal ~ "HL",
`Pr(z > 0)` <= 0.05 & Ii < 0 & model_df$poverty_below_150 < meanVal ~ "LH"))
# Now add this coType to original sf data
model_df$coType <- lisaRslt$coType %>% replace_na("Insignificant")
#Now we'll plot it!
ggplot(model_df) +
geom_sf(aes(fill=coType),color = 'black') +
scale_fill_manual(values = c('red','lightgrey','NA','blue','cyan'), name='Clusters & \nOutliers') +
labs(title = "Percent at or above 150% Poverty Level")+
theme_minimal()
# Formula for regression
# I() function taught in MATH455
form = poverty_below_150 ~ educ_hs_grad + marital_married + I(pop_male/total_pop) +lang_non_english_speak_english_less_than_very_well + race_white + hispanic_latino + median_age
lmod = lm(form, data = model_df)
summary(lmod)
#run the Moran's I test for regression residuals
lm.morantest(lmod, fl_list)
lm_error <- errorsarlm(form,
data = model_df,
listw = fl_list,
zero.policy = TRUE,
na.action = na.omit)
summary(lm_error)
seResiduals <- rep(0, length(model_df$poverty_below_150))
#create an index based on the order of the residuals in the lm_error object
resIndex <- lm_error$residuals %>% names() %>% as.integer();
#use the index to fill in the seResiduals object with corresponding residual values
seResiduals[resIndex] <- lm_error$residuals
#perform the Moran Test
fl_list %>%
moran.test(seResiduals, ., zero.policy = TRUE)
dim(fl_list)
View(fl_list)
lm_lag <- lagsarlm(form,
data = model_df,
listw = fl_list,
zero.policy = TRUE,
na.action = na.omit)
summary(lm_lag)
seResiduals <- rep(0, length(model_df$poverty_below_150))
resIndex <- lm_lag$residuals %>% names() %>% as.integer();
seResiduals[resIndex] <- lm_lag$residuals
#perform the Moran Test
fl_list %>%
moran.test(seResiduals, ., zero.policy = TRUE)
dim(model_df)
